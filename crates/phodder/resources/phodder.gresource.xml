    <file alias="metainfo.xml">../../../data/net.dunevent.Phodder.metainfo.xml</file>
  </gresource>
  <!-- add_resource_path gets the base icons path; GTK appends
       size/context itself, so prefixes spell out the rest. Bundled icons
       are a fallback: a theme that has the icon still wins. -->
