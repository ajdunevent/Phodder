    <file alias="skip-forward-30-symbolic.svg">icons/skip-forward-30-symbolic.svg</file>
    <!-- Adwaita's view-refresh under Phodder's own name, so no theme swaps
         in a version the spin's offset doesn't fit. -->
    <file alias="phodder-refresh-symbolic.svg">icons/phodder-refresh-symbolic.svg</file>
  </gresource>
